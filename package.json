{
  "name": "latte",
  "version": "1.6.0",
  "private": true,
  "description": "Latte - An Agent Marketing Platform. Local-first desktop workspace for directing coding/marketing agents around brands and deliverables.",
  "license": "MIT",
  "author": "Oh My Latte <hola@ohmylatte.app>",
  "homepage": "https://ohmylatte.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmylatte/latte.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:main": "node scripts/build-electron.mjs",
    "assets:installer": "electron scripts/make-installer-sidebar.cjs",
    "assets:icons": "electron scripts/make-print-icons.cjs && node scripts/make-icon.mjs",
    "build:desktop": "npm run build && npm run build:main",
    "pack:win": "npm run build:desktop && electron-builder --win --publish never",
    "pack:mac": "npm run build:desktop && electron-builder --mac --x64 --arm64 --publish never",
    "pack:linux": "npm run build:desktop && electron-builder --linux --publish never",
    "release:win": "npm run build:desktop && electron-builder --win --publish always",
    "release:mac": "npm run build:desktop && electron-builder --mac --x64 --arm64 --publish always",
    "release:linux": "npm run build:desktop && electron-builder --linux --publish always",
    "start": "node scripts/start.mjs",
    "dev:web": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "probe:electron": "electron scripts/probe-electron.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.web-tests.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:web",
    "smoke:opencode": "tsx scripts/smoke-opencode.ts",
    "smoke:desktop": "cross-env LATTE_SMOKE_EXIT_MS=15000 node scripts/dev.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.0"
  }
}
